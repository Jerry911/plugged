<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration of Plugged (read by Spring Boot instead of its default).
  - Console: always.
  - File logs/plugged.log (rolled daily and at 10 MB, 30 days kept): only with the Spring profile "file" (spring.profiles.active=file).
  - Every line carries the signed-in user who caused it ([%X{user}], his email address; "-" without one: start-up, sign-in pages),
    see logging/UserMdcFilter.
  - Levels: logging.level.* in application.properties / environment, e.g. PLUGGED_LOG_LEVEL=TRACE also logs the (truncated) request bodies.
  - logging.threshold.console (Spring Boot): the lowest level that reaches the console, OFF = nothing. The tests use it to keep the
    output of `mvn install` and of Playwright clean (src/test/resources/application.properties, frontend/e2e/application-test.properties);
    the levels themselves stay, so the code runs exactly as in production.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty scope="context" name="LOG_DIR" source="plugged.log.dir" defaultValue="logs"/>

    <property name="PLUGGED_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{user:--}] %-28.28logger{27} : %msg%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${CONSOLE_LOG_THRESHOLD}</level>
        </filter>
        <encoder>
            <pattern>${PLUGGED_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="file">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/plugged.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/plugged.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${PLUGGED_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <logger name="com.pleysje.plugged" level="DEBUG"/>

    <!-- one root per case: Spring Boot does not allow <springProfile> inside <root> (it warns on every start) -->
    <springProfile name="file">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
    <springProfile name="!file">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>

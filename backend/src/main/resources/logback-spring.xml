<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration of Plugged (read by Spring Boot instead of its default).
  - Console: always.
  - File logs/plugged.log (rolled daily and at 10 MB, 30 days kept): only with the Spring profile "file" (spring.profiles.active=file).
  - Levels: logging.level.* in application.properties / environment, e.g. PLUGGED_LOG_LEVEL=TRACE also logs the (truncated) request bodies.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty scope="context" name="LOG_DIR" source="plugged.log.dir" defaultValue="logs"/>

    <property name="PLUGGED_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %-28.28logger{27} : %msg%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PLUGGED_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <springProfile name="file">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/plugged.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/plugged.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>30</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${PLUGGED_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <logger name="com.pleysje.plugged" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <springProfile name="file">
            <appender-ref ref="FILE"/>
        </springProfile>
    </root>
</configuration>
